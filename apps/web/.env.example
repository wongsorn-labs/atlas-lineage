VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Optional: hide a sign-in method on the login page. Both default to
# enabled when unset -- only set these to the literal string "false" to
# hide one. (Also configure the provider itself in the Supabase dashboard
# under Authentication -> Providers; this only controls the login page UI.)
VITE_ENABLE_EMAIL_AUTH=true
VITE_ENABLE_GOOGLE_AUTH=true

# Required for MapView's basemap tiles to render (CARTO now requires a key
# for its light_all/dark_all raster tiles -- without it CARTO serves an
# "API KEY REQUIRED" watermark instead of the map). Free, no CARTO account
# needed, issued instantly: https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=your_carto_api_key_here
